# ── MQTT Broker ──────────────────────────────────────────────────────────────
# Point this to the machine running polar-twin-backend
# If running on the SAME server: use the backend container/service IP
# If running on a DIFFERENT machine: use the public IP or domain of that server
MQTT_HOST=your-backend-server-ip-or-domain
MQTT_PORT=1883
